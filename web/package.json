{
  "name": "harnesscope-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --config ../e2e.config.ts",
    "test:e2e:headed": "npm run test:e2e -- --headed"
  },
  "dependencies": {
    "parse-duration": "^2.1.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.12.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "e2e": "0.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
